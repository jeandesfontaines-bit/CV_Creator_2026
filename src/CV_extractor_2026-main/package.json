    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test src/lib/cv/parse.test.ts"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "engines": { "node": ">=22" }
}
