{
  "name": "cv-extractor-2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CV-only extraction engine and document readers separated from JobPilot",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
