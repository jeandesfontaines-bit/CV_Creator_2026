                  <div
                    key={p.id}
                    id={`a4-sheet-${p.id}`}
                    data-page-id={p.id}
                    onClick={() => setCurrentPageId(p.id)}
                    className={`print-page relative bg-white rounded-[4px] shadow-[0_1px_3px_rgba(0,0,0,0.08),0_8px_24px_rgba(0,0,0,0.06)] transition-all ${currentPageId === p.id ? 'ring-2 ring-blue-500/30' : ''}`}
                    style={{ width: 794, height: 1123, minWidth: 794, minHeight: 1123, flexShrink: 0 }}
