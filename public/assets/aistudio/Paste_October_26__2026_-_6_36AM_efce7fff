      const [rotateState, setRotateState] = useState(null);
      const [panState, setPanState] = useState({ x: 0, y: 0, isPanning: false, startX: 0, startY: 0 });
      const [isSpacePressed, setIsSpacePressed] = useState(false);
      const [lassoState, setLassoState] = useState(null);

      // Historique Undo / Redo
      const [history, setHistory] = useState([]);
      const [histIdx, setHistIdx] = useState(-1);

      // Modale d'import
      const [isImportOpen, setIsImportOpen] = useState(false);
      const [importText, setImportText] = useState("");

      const canvasRef = useRef(null);
      const jsonInputRef = useRef(null);

      // Calcul du score de complétion du CV
      const currentElements = useMemo(() => {
        return (pages.find(p => p.id === currentPageId) || pages[0]).elements;
      }, [pages, currentPageId]);

      const cvHealth = useMemo(() => {
        let score = 20;
        const hasName = currentElements.some(e => e.type === 'heading' && String(e.content).length > 3);
        const hasEmail = currentElements.some(e => e.type === 'icon' || (typeof e.content === 'string' && e.content.includes('@')));
        const hasExp = currentElements.filter(e => e.type === 'experience').length >= 2;
        const hasSkills = currentElements.some(e => e.type === 'skills' && Array.isArray(e.content) && e.content.length >= 3);

        if (hasName) score += 20;
        if (hasEmail) score += 20;
        if (hasExp) score += 20;
        if (hasSkills) score += 20;

        return { score: Math.min(100, score), hasName, hasEmail, hasExp, hasSkills };
      }, [currentElements]);

      // Améliorateur de formulation pro en 1 clic
      const boostText = (el) => {
        if (!el) return;
        const boosters = [
          "Pilotage stratégique et optimisation des processus opérationnels avec dépassement des objectifs annuels de +24%.",
          "Conception et mise en œuvre de solutions à fort impact, réduisant les délais d'exécution de 30%.",
          "Coordination d'initiatives transverses et gestion des parties prenantes pour maximiser la satisfaction client.",
          "Déploiement d'une méthodologie agile rigoureuse favorisant la qualité des livrables et la performance d'équipe."
        ];
        const randomBoost = boosters[Math.floor(Math.random() * boosters.length)];
        
        if (el.type === 'experience' && el.content) {
          updateElement(el.id, {
            content: {
              ...el.content,
              desc: `${el.content.desc} ${randomBoost}`
            }
          });
          showToast("✨ Description enrichie avec succès !");
        } else if (['text', 'heading'].includes(el.type)) {
          updateElement(el.id, { content: randomBoost });
          showToast("✨ Texte reformulé comme un pro !");
        }
      };

      // Appliquer une palette de couleurs au CV entier en 1 clic
      const applyColorTheme = (theme) => {
        const updated = pages.map(p => {
          if (p.id !== currentPageId) return p;
          return {
            ...p,
            elements: p.elements.map(el => {
              if (el.type === 'rect' && el.y === 0 && el.h > 100) {
                return { ...el, style: { ...el.style, backgroundColor: theme.primary } };
              }
              if (el.type === 'circle' || (el.type === 'rect' && el.style.backgroundColor && el.style.backgroundColor !== 'transparent' && el.style.backgroundColor !== '#f4f4f5')) {
                return { ...el, style: { ...el.style, backgroundColor: theme.primary } };
              }
              if (el.type === 'dividerH' || el.type === 'dividerV') {
                return { ...el, style: { ...el.style, backgroundColor: theme.accent } };
              }
              return el;
            })
          };
        });
        updatePages(updated);
        showToast(`Palette "${theme.name}" appliquée`);
      };

      // Gestion native des gestes Trackpad Apple (Pinch-to-zoom & Pan fluide à 2 doigts)
      useEffect(() => {
        const canvasEl = canvasRef.current;
        if (!canvasEl) return;

        const handleWheel = (e) => {
          if (e.ctrlKey || e.metaKey) {
            e.preventDefault();
            const zoomSensitivity = 0.01;
            const factor = 1 - e.deltaY * zoomSensitivity;
            setZoom((prevZoom) => Math.min(300, Math.max(25, Math.round(prevZoom * factor))));
            return;
          }

          if (!isSpacePressed && (Math.abs(e.deltaX) > 0 || Math.abs(e.deltaY) > 0)) {
            if (!e.target.closest('textarea') && !e.target.closest('.overflow-y-auto')) {
              e.preventDefault();
              setPanState((prev) => ({
                ...prev,
                x: prev.x - e.deltaX,
                y: prev.y - e.deltaY
              }));
            }
          }
        };

        let gestureStartZoom = 85;
        const handleGestureStart = (e) => {
          e.preventDefault();
          setZoom((current) => {
            gestureStartZoom = current;
            return current;
          });
        };

        const handleGestureChange = (e) => {
          e.preventDefault();
          const newZoom = Math.min(300, Math.max(25, Math.round(gestureStartZoom * e.scale)));
          setZoom(newZoom);
        };

        const handleGestureEnd = (e) => {
          e.preventDefault();
        };

        canvasEl.addEventListener("wheel", handleWheel, { passive: false });
        canvasEl.addEventListener("gesturestart", handleGestureStart, { passive: false });
        canvasEl.addEventListener("gesturechange", handleGestureChange, { passive: false });
        canvasEl.addEventListener("gestureend", handleGestureEnd, { passive: false });

        return () => {
          canvasEl.removeEventListener("wheel", handleWheel);
          canvasEl.removeEventListener("gesturestart", handleGestureStart);
          canvasEl.removeEventListener("gesturechange", handleGestureChange);
          canvasEl.removeEventListener("gestureend", handleGestureEnd);
        };
      }, [isSpacePressed]);

      const currentPage = useMemo(() => {
        return pages.find(p => p.id === currentPageId) || pages[0];
      }, [pages, currentPageId]);

      const selectedEls = useMemo(() => {
        return currentPage.elements.filter(el => selectedIds.includes(el.id));
      }, [currentPage, selectedIds]);

      const primarySelected = selectedEls.length === 1 ? selectedEls[0] : null;

      const showToast = (txt) => {
        setToastMsg(txt);
        setTimeout(() => setToastMsg(null), 2400);
      };

      const pushHistory = (newPages) => {
        const snap = JSON.parse(JSON.stringify(newPages));
        const updated = history.slice(0, histIdx + 1);
        if (updated.length > 40) updated.shift();
        updated.push(snap);
        setHistory(updated);
        setHistIdx(updated.length - 1);
      };

      const updatePages = (newPages, record = true) => {
        if (record) pushHistory(pages);
        setPages(newPages);
      };

      const undo = () => {
        if (histIdx > 0) {
          const prev = history[histIdx - 1];
          setHistIdx(histIdx - 1);
          setPages(JSON.parse(JSON.stringify(prev)));
        }
      };

      const redo = () => {
        if (histIdx < history.length - 1) {
          const next = history[histIdx + 1];
          setHistIdx(histIdx + 1);
          setPages(JSON.parse(JSON.stringify(next)));
        }
      };

      // Raccourcis Clavier
      useEffect(() => {
        const handleKeyDown = (e) => {
          if (e.code === "Space") setIsSpacePressed(true);

          if (e.target.isContentEditable || e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;

          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'z') {
            e.preventDefault();
            if (e.shiftKey) redo();
            else undo();
          }
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'y') {
            e.preventDefault();
            redo();
          }
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'd') {
            e.preventDefault();
            duplicateSelected();
          }
          if (e.key === "Backspace" || e.key === "Delete") {
            e.preventDefault();
            deleteSelected();
          }

          if (e.key.startsWith("Arrow") && selectedIds.length > 0) {
            e.preventDefault();
            const step = e.shiftKey ? 10 : 1;
            const dx = e.key === "ArrowLeft" ? -step : e.key === "ArrowRight" ? step : 0;
            const dy = e.key === "ArrowUp" ? -step : e.key === "ArrowDown" ? step : 0;
            const updated = pages.map(p => p.id === currentPageId ? {
              ...p,
              elements: p.elements.map(el => selectedIds.includes(el.id) ? { ...el, x: el.x + dx, y: el.y + dy } : el)
            } : p);
            updatePages(updated, false);
          }
        };

        const handleKeyUp = (e) => {
          if (e.code === "Space") setIsSpacePressed(false);
        };

        window.addEventListener("keydown", handleKeyDown);
        window.addEventListener("keyup", handleKeyUp);
        return () => {
          window.removeEventListener("keydown", handleKeyDown);
          window.removeEventListener("keyup", handleKeyUp);
        };
      }, [selectedIds, pages, currentPageId, histIdx, history]);

      const updateElement = (id, partial) => {
        const updated = pages.map(p => p.id === currentPageId ? {
          ...p,
          elements: p.elements.map(el => el.id === id ? {
            ...el,
            ...partial,
            style: { ...el.style, ...(partial.style || {}) }
          } : el)
        } : p);
        setPages(updated);
      };

      const deleteSelected = () => {
        if (selectedIds.length === 0) return;
        const updated = pages.map(p => p.id === currentPageId ? {
          ...p,
          elements: p.elements.filter(el => !selectedIds.includes(el.id))
        } : p);
        updatePages(updated);
        setSelectedIds([]);
        showToast("Élément(s) supprimé(s)");
      };

      const duplicateSelected = () => {
        if (selectedIds.length === 0) return;
        const newIds = [];
        const updated = pages.map(p => {
          if (p.id !== currentPageId) return p;
          const cloned = p.elements.filter(el => selectedIds.includes(el.id)).map(el => {
            const newId = uid();
            newIds.push(newId);
            return {
              ...JSON.parse(JSON.stringify(el)),
              id: newId,
              x: el.x + 20,
              y: el.y + 20,
              zIndex: Math.max(...p.elements.map(e => e.zIndex), 0) + 1
            };
          });
          return { ...p, elements: [...p.elements, ...cloned] };
        });
        updatePages(updated);
        setSelectedIds(newIds);
        showToast("Élément(s) dupliqué(s)");
      };

      const addElement = (type) => {
        let el;
        const centerX = 80;
        const centerY = 120;

        switch (type) {
          case 'heading':
            el = makeEl({ type: 'heading', x: centerX, y: centerY, w: 320, h: 36, content: "Nouveau Titre", style: { fontSize: 20, fontWeight: "700", color: "#0f0f10" } });
            break;
          case 'text':
            el = makeEl({ type: 'text', x: centerX, y: centerY, w: 300, h: 48, content: "Double-cliquez pour saisir votre texte librement.", style: { fontSize: 13, color: "#27272a" } });
            break;
          case 'experience':
            el = makeEl({ type: 'experience', x: centerX, y: centerY, w: 600, h: 110, content: { role: "Nouveau Poste", company: "Entreprise — Ville", date: "2023 — Présent", desc: "Description du rôle et réalisations clés." } });
            break;
          case 'education':
            el = makeEl({ type: 'education', x: centerX, y: centerY, w: 600, h: 50, content: { degree: "Diplôme / Certificat", school: "École / Université", date: "2020 — 2023" } });
            break;
          case 'skills':
            el = makeEl({ type: 'skills', x: centerX, y: centerY, w: 600, h: 60, content: ["Figma", "UI/UX", "Tailwind", "React"] });
            break;
          case 'progress':
            el = makeEl({ type: 'progress', x: centerX, y: centerY, w: 300, h: 80, content: [{ label: "Compétence", val: 80 }] });
            break;
          case 'image':
            el = makeEl({ type: 'image', x: centerX, y: centerY, w: 110, h: 110, content: "", style: { borderRadius: 12, backgroundColor: "#e4e4e7" } });
            break;
          case 'rect':
            el = makeEl({ type: 'rect', x: centerX, y: centerY, w: 200, h: 100, style: { backgroundColor: "#f4f4f5", borderRadius: 8, borderWidth: 1, borderColor: "#e4e4e7" } });
            break;
          case 'circle':
            el = makeEl({ type: 'circle', x: centerX, y: centerY, w: 100, h: 100, style: { backgroundColor: "#0f0f10", borderRadius: 999 } });
            break;
          case 'dividerH':
            el = makeEl({ type: 'dividerH', x: centerX, y: centerY, w: 300, h: 2, style: { backgroundColor: "#e4e4e7" } });
            break;
          case 'dividerV':
            el = makeEl({ type: 'dividerV', x: centerX, y: centerY, w: 2, h: 200, style: { backgroundColor: "#e4e4e7" } });
            break;
          case 'icon':
            el = makeEl({ type: 'icon', x: centerX, y: centerY, w: 220, h: 20, content: { icon: "✉", text: "contact@email.com" } });
            break;
          default:
            el = makeEl({ type: 'text', x: centerX, y: centerY, w: 200, h: 30, content: "Texte" });
        }

        const maxZ = Math.max(...currentPage.elements.map(e => e.zIndex), 0);
        el.zIndex = maxZ + 1;

        const updated = pages.map(p => p.id === currentPageId ? { ...p, elements: [...p.elements, el] } : p);
        updatePages(updated);
        setSelectedIds([el.id]);
        showToast("Élément ajouté");
      };

      const handleImageUpload = (id, file) => {
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (e) => {
          updateElement(id, { content: e.target.result });
          showToast("Image importée");
        };
        reader.readAsDataURL(file);
      };

      // Mouse Handlers
      const handleElementMouseDown = (e, el) => {
        if (el.locked || isSpacePressed) return;
        e.stopPropagation();

        let newSelected = selectedIds;
        if (e.shiftKey) {
          newSelected = selectedIds.includes(el.id)
            ? selectedIds.filter(id => id !== el.id)
            : [...selectedIds, el.id];
          setSelectedIds(newSelected);
        } else if (!selectedIds.includes(el.id)) {
          newSelected = [el.id];
          setSelectedIds(newSelected);
        }

        const origins = new Map();
        currentPage.elements
          .filter(item => newSelected.includes(item.id))
          .forEach(item => origins.set(item.id, { x: item.x, y: item.y }));

        setDragState({
          startX: e.clientX,
          startY: e.clientY,
          origins,
          ids: newSelected
        });
      };

      const handleMouseMove = (e) => {
        const scale = zoom / 100;

        if (panState.isPanning) {
          setPanState(prev => ({
            ...prev,
            x: e.clientX - prev.startX,
            y: e.clientY - prev.startY
          }));
          return;
        }

        if (dragState) {
          const deltaX = (e.clientX - dragState.startX) / scale;
          const deltaY = (e.clientY - dragState.startY) / scale;

          let guideX = [];
          let guideY = [];
          let finalDeltaX = deltaX;
          let finalDeltaY = deltaY;

          if (smartGuides) {
            const others = currentPage.elements.filter(el => !dragState.ids.includes(el.id));
            const primaryId = dragState.ids[0];
            const primaryOrig = dragState.origins.get(primaryId);
            const primaryEl = currentPage.elements.find(el => el.id === primaryId);

            if (primaryOrig && primaryEl) {
              const curX = primaryOrig.x + deltaX;
              const curY = primaryOrig.y + deltaY;

              // Centre A4 (397px)
              if (Math.abs(curX + primaryEl.w / 2 - 397) < 6) {
                finalDeltaX = 397 - primaryEl.w / 2 - primaryOrig.x;
                guideX.push(397);
              }

              for (const o of others) {
                if (Math.abs(curX - o.x) < 5) {
                  finalDeltaX = o.x - primaryOrig.x;
                  guideX.push(o.x);
                }
                if (Math.abs(curX + primaryEl.w - (o.x + o.w)) < 5) {
                  finalDeltaX = o.x + o.w - primaryEl.w - primaryOrig.x;
                  guideX.push(o.x + o.w);
                }
                if (Math.abs(curY - o.y) < 5) {
                  finalDeltaY = o.y - primaryOrig.y;
                  guideY.push(o.y);
                }
              }
            }
          }

          setActiveGuides({ x: guideX, y: guideY });

          const updatedElements = currentPage.elements.map(el => {
            if (!dragState.ids.includes(el.id)) return el;
            const orig = dragState.origins.get(el.id);
            if (!orig) return el;
            let nx = orig.x + finalDeltaX;
            let ny = orig.y + finalDeltaY;

            if (snapToGrid && guideX.length === 0 && guideY.length === 0) {
              nx = Math.round(nx / 20) * 20;
              ny = Math.round(ny / 20) * 20;
            }

            return { ...el, x: Math.round(nx), y: Math.round(ny) };
          });

          setPages(pages.map(p => p.id === currentPageId ? { ...p, elements: updatedElements } : p));
        }

        if (resizeState) {
          const { id, handle, startX, startY, orig, aspectRatio } = resizeState;
          const dx = (e.clientX - startX) / scale;
          const dy = (e.clientY - startY) / scale;

          let newW = orig.w;
          let newH = orig.h;
          let newX = orig.x;
          let newY = orig.y;

          if (handle.includes('e')) newW = Math.max(20, orig.w + dx);
          if (handle.includes('s')) newH = Math.max(10, orig.h + dy);
          if (handle.includes('w')) {
            const pW = orig.w - dx;
            if (pW > 20) { newW = pW; newX = orig.x + dx; }
          }
          if (handle.includes('n')) {
            const pH = orig.h - dy;
            if (pH > 10) { newH = pH; newY = orig.y + dy; }
          }

          if (e.shiftKey && ['se', 'nw', 'ne', 'sw'].includes(handle)) {
            newH = newW / aspectRatio;
          }

          if (snapToGrid) {
            newW = Math.round(newW / 20) * 20;
            newH = Math.round(newH / 20) * 20;
          }

          updateElement(id, { x: Math.round(newX), y: Math.round(newY), w: Math.round(newW), h: Math.round(newH) });
        }

        if (rotateState) {
          const { id, center } = rotateState;
          const rad = Math.atan2(e.clientY - center.y, e.clientX - center.x);
          let deg = Math.round(rad * (180 / Math.PI)) + 90;
          if (e.shiftKey) deg = Math.round(deg / 15) * 15;
          updateElement(id, { rotation: deg });
        }

        if (lassoState?.active) {
          const rect = canvasRef.current?.getBoundingClientRect();
          if (!rect) return;
          const curX = (e.clientX - rect.left - panState.x) / scale;
          const curY = (e.clientY - rect.top - panState.y) / scale;
          setLassoState(prev => ({ ...prev, curX, curY }));
        }
      };

      const handleMouseUp = () => {
        if (dragState) {
          pushHistory(pages);
          setDragState(null);
          setActiveGuides({ x: [], y: [] });
        }
        if (resizeState) {
          pushHistory(pages);
          setResizeState(null);
        }
        if (rotateState) {
          pushHistory(pages);
          setRotateState(null);
        }
        if (lassoState?.active) {
          const minX = Math.min(lassoState.startX, lassoState.curX);
          const maxX = Math.max(lassoState.startX, lassoState.curX);
          const minY = Math.min(lassoState.startY, lassoState.curY);
          const maxY = Math.max(lassoState.startY, lassoState.curY);

          const found = currentPage.elements.filter(el => {
            return el.x >= minX && (el.x + el.w) <= maxX && el.y >= minY && (el.y + el.h) <= maxY;
          }).map(e => e.id);

          setSelectedIds(found);
          setLassoState(null);
        }
        if (panState.isPanning) {
          setPanState(prev => ({ ...prev, isPanning: false }));
        }
      };

      // Export PNG & Print
      const exportPNG = async () => {
        showToast("Export PNG haute résolution...");
        try {
          const sheet = document.getElementById(`a4-sheet-${currentPageId}`);
          if (!sheet) return;
          const dataUrl = await window.htmlToImage.toPng(sheet, { pixelRatio: 2.5, quality: 1 });
          const a = document.createElement('a');
          a.href = dataUrl;
          a.download = `CV-${DEFAULT_PROFILE.name.replace(/\s+/g, '_')}.png`;
          a.click();
          showToast("PNG téléchargé avec succès !");
        } catch (err) {
          console.error(err);
          showToast("Erreur lors de l'export PNG");
        }
      };

      const exportPrint = () => {
        setSelectedIds([]);
        setTimeout(() => window.print(), 120);
      };

      const exportJSON = () => {
        const blob = new Blob([JSON.stringify(pages, null, 2)], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `cv-project-${Date.now()}.json`;
        a.click();
        URL.revokeObjectURL(url);
        showToast("Projet exporté en JSON");
      };

      const handleJSONImport = (e) => {
        const file = e.target.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (event) => {
          try {
            const data = JSON.parse(event.target.result);
            if (Array.isArray(data)) {
              updatePages(data);
              setCurrentPageId(data[0].id);
              showToast("Projet JSON restauré !");
            }
          } catch (err) {
            alert("Fichier JSON invalide.");
          }
        };
        reader.readAsText(file);
      };

      return (
        <div 
          className="flex h-screen w-screen overflow-hidden bg-[#e8e5df] text-[#0f0f10]"
          onMouseMove={handleMouseMove}
          onMouseUp={handleMouseUp}
        >
          {/* BARRE LATÉRALE GAUCHE (DESIGN ORIGINAL FONCÉ #0f0f10) */}
          <aside className="no-print w-[310px] shrink-0 bg-[#0f0f10] text-[#fafafa] flex flex-col border-r border-[#27272a] shadow-2xl z-30 select-none">
            {/* Header Pro */}
            <div className="h-[64px] px-5 flex items-center justify-between border-b border-[#1f1f23] shrink-0">
              <div className="flex items-center gap-3">
                <div className="w-8 h-8 rounded-[8px] bg-white text-black flex items-center justify-center font-black text-[14px]">
                  CV
                </div>
                <div>
                  <div className="text-[13px] font-bold tracking-wide leading-none">CV DESIGNER PRO</div>
                  <div className="text-[10px] text-[#71717a] tracking-[1.5px] mt-[3px]">ÉDITION LIBRE</div>
                </div>
              </div>
              <div className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" title="Auto-save actif"></div>
            </div>

            {/* Contenu Déroulant */}
            <div className="flex-1 overflow-y-auto px-3 py-4 space-y-5">
              
              {/* NOUVEAUTÉ ANTI-PANNE D'IDÉES : PROFILES PAR MÉTIER EN 1 CLIC */}
              <div className="space-y-2">
                <div className="flex items-center justify-between">
                  <span className="text-[11px] font-bold tracking-[1.2px] text-amber-400 uppercase">⚡ 0 Panne d'idée</span>
                  <span className="text-[9px] text-zinc-400">1 clic = pré-rempli</span>
                </div>
                <div className="grid grid-cols-2 gap-1.5">
                  {Object.entries(JOB_PRESETS).map(([k, p]) => (
                    <button
                      key={k}
                      onClick={() => {
                        const built = TEMPLATES.modern.build(p);
                        const updated = pages.map(pg => pg.id === currentPageId ? { ...pg, elements: built } : pg);
                        updatePages(updated);
                        setSelectedIds([]);
                        showToast(`Modèle "${p.label}" chargé !`);
                      }}
                      className="h-8 px-2 rounded-lg bg-[#18181b] border border-[#27272a] hover:border-amber-400/60 hover:bg-[#232326] text-[10px] font-medium text-left truncate transition"
                    >
                      {p.label}
                    </button>
                  ))}
                </div>
              </div>

              {/* NOUVEAUTÉ : PALETTES DE COULEURS HARMONIEUSES */}
              <div className="space-y-2">
