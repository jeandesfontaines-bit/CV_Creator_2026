                </button>
                <button onClick={exportPrint} className="h-9 rounded-lg bg-[#18181b] border border-[#27272a] text-[11px] font-bold hover:bg-[#232326]">
                  PDF / Print
                </button>
                <button onClick={exportPNG} className="h-9 rounded-lg bg-[#18181b] border border-[#27272a] text-[11px] font-bold hover:bg-[#232326]">
                  PNG HD
