                    {p.elements.filter(el => el.visible).map((el) => {
                      const isSelected = selectedIds.includes(el.id);

                      return (
                        <div
                          key={el.id}
                          data-element={el.id}
                          onMouseDown={(e) => handleElementMouseDown(e, el)}
                          onDoubleClick={() => {
                            if (['text', 'heading'].includes(el.type)) {
                              setEditingId(el.id);
                              setSelectedIds([el.id]);
                            }
                          }}
                          className={`absolute select-none ${el.locked ? 'cursor-not-allowed' : 'cursor-move'}`}
                          style={{
                            left: el.x,
                            top: el.y,
                            width: el.w,
                            height: el.h,
                            zIndex: el.zIndex,
                            transform: `rotate(${el.rotation || 0}deg)`,
                            opacity: el.style.opacity ?? 1
                          }}
                        >
                          {/* Composant interne */}
                          <div
                            className="w-full h-full relative overflow-hidden"
                            style={{
                              backgroundColor: el.style.backgroundColor || (el.type === 'rect' ? el.style.backgroundColor : 'transparent'),
                              borderRadius: el.style.borderRadius ?? (el.type === 'circle' ? 999 : 0),
                              borderWidth: el.style.borderWidth ? `${el.style.borderWidth}px` : undefined,
                              borderColor: el.style.borderColor,
                              borderStyle: el.style.borderStyle || 'solid'
                            }}
                          >
                            {/* Titres */}
                            {el.type === 'heading' && (
                              <div
                                contentEditable={editingId === el.id}
                                suppressContentEditableWarning
                                onBlur={(e) => {
                                  updateElement(el.id, { content: e.currentTarget.innerText });
                                  setEditingId(null);
                                }}
                                className="w-full h-full outline-none font-bold"
                                style={{
                                  fontFamily: el.style.fontFamily || "Inter",
                                  fontSize: `${el.style.fontSize || 20}px`,
                                  fontWeight: el.style.fontWeight || "700",
                                  color: el.style.color || "#0f0f10",
                                  lineHeight: el.style.lineHeight || 1.2,
                                  textAlign: el.style.textAlign || "left"
                                }}
                              >
                                {el.content}
                              </div>
                            )}

                            {/* Textes éditables */}
                            {el.type === 'text' && (
                              <div
                                contentEditable={editingId === el.id}
                                suppressContentEditableWarning
                                onBlur={(e) => {
                                  updateElement(el.id, { content: e.currentTarget.innerText });
                                  setEditingId(null);
                                }}
                                className="w-full h-full outline-none"
                                style={{
                                  fontFamily: el.style.fontFamily || "Inter",
                                  fontSize: `${el.style.fontSize || 13}px`,
                                  fontWeight: el.style.fontWeight || "400",
                                  color: el.style.color || "#27272a",
                                  lineHeight: el.style.lineHeight || 1.5,
                                  textAlign: el.style.textAlign || "left",
                                  whiteSpace: "pre-wrap"
                                }}
                              >
                                {el.content}
                              </div>
                            )}

                            {/* Expériences */}
                            {el.type === 'experience' && (
                              <div className="w-full h-full" style={{ fontFamily: el.style.fontFamily || "Inter" }}>
                                <div className="text-[13px] font-bold leading-tight" style={{ color: el.style.color || "#0f0f10" }}>
                                  {el.content?.role}
                                </div>
                                <div className="text-[11px] font-medium text-zinc-500 mt-[2px]">
                                  {el.content?.company} • {el.content?.date}
                                </div>
                                <div className="text-[12px] text-zinc-600 mt-2 leading-[1.5] line-clamp-3">
                                  {el.content?.desc}
                                </div>
                              </div>
                            )}

                            {/* Formations */}
                            {el.type === 'education' && (
                              <div className="w-full" style={{ fontFamily: el.style.fontFamily || "Inter" }}>
                                <div className="text-[12px] font-bold text-zinc-900">{el.content?.degree}</div>
                                <div className="text-[11px] text-zinc-500">{el.content?.school} • {el.content?.date}</div>
                              </div>
                            )}

                            {/* Compétences / Badges */}
                            {el.type === 'skills' && (
                              <div className="flex flex-wrap gap-1.5">
                                {(Array.isArray(el.content) ? el.content : []).map((s, idx) => (
                                  <span
                                    key={idx}
                                    className="px-2.5 py-1 rounded-full text-[11px] font-medium border"
                                    style={{
                                      backgroundColor: el.style?.color === "#ffffff" ? "#27272a" : "#f4f4f5",
                                      color: el.style?.color === "#ffffff" ? "#ffffff" : "#27272a",
                                      borderColor: el.style?.color === "#ffffff" ? "#3f3f46" : "#e4e4e7"
                                    }}
                                  >
                                    {s}
                                  </span>
                                ))}
                              </div>
                            )}

                            {/* Barres de progression / Jauges */}
                            {el.type === 'progress' && (
                              <div className="space-y-2">
                                {(Array.isArray(el.content) ? el.content : []).map((item, idx) => (
                                  <div key={idx} className="space-y-1">
                                    <div className="flex justify-between text-[10px] font-medium text-zinc-600">
                                      <span>{item.label}</span>
                                      <span>{item.val}%</span>
                                    </div>
                                    <div className="h-1.5 rounded-full bg-zinc-200 overflow-hidden">
                                      <div className="h-full bg-[#0f0f10]" style={{ width: `${item.val}%` }}></div>
                                    </div>
                                  </div>
                                ))}
                              </div>
                            )}

                            {/* Photo de profil */}
                            {el.type === 'image' && (
                              <div className="w-full h-full relative group">
                                {el.content ? (
                                  <img src={el.content} alt="Profil" className="w-full h-full object-cover" style={{ borderRadius: el.style.borderRadius || 12 }} />
                                ) : (
                                  <div className="w-full h-full flex flex-col items-center justify-center bg-zinc-100 text-zinc-400">
                                    <span className="text-xs font-bold">Photo</span>
                                  </div>
                                )}
                                <label className="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 cursor-pointer transition text-white text-[11px] font-bold">
                                  Changer
                                  <input type="file" accept="image/*" className="hidden" onChange={(e) => handleImageUpload(el.id, e.target.files?.[0])} />
                                </label>
                              </div>
                            )}

                            {/* Formes géométriques */}
                            {el.type === 'rect' && <div className="w-full h-full"></div>}
                            {el.type === 'circle' && <div className="w-full h-full rounded-full" style={{ backgroundColor: el.style.backgroundColor || "#0f0f10" }}></div>}
                            {el.type === 'dividerH' && <div className="w-full h-full" style={{ backgroundColor: el.style.backgroundColor || "#e4e4e7" }}></div>}
                            {el.type === 'dividerV' && <div className="w-full h-full" style={{ backgroundColor: el.style.backgroundColor || "#e4e4e7" }}></div>}

                            {/* Icônes de contact */}
                            {el.type === 'icon' && (
                              <div className="flex items-center gap-1.5 text-[12px]" style={{ color: el.style.color || "#27272a" }}>
                                <span className="font-bold">{el.content?.icon || "✉"}</span>
                                <span className="truncate">{el.content?.text}</span>
                              </div>
                            )}
                          </div>

                          {/* Cadre de Sélection Figma (Bordure bleue + 8 Poignées + Rotation) */}
                          {isSelected && !el.locked && (
                            <React.Fragment>
                              <div className="absolute inset-0 border-2 border-[#3b82f6] pointer-events-none rounded-[2px]" />

                              {/* Poignées */}
                              {[
                                { h: 'nw', cls: 'top-0 left-0 -translate-x-1/2 -translate-y-1/2 cursor-nwse-resize' },
                                { h: 'n',  cls: 'top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 cursor-ns-resize' },
                                { h: 'ne', cls: 'top-0 right-0 translate-x-1/2 -translate-y-1/2 cursor-nesw-resize' },
                                { h: 'e',  cls: 'top-1/2 right-0 translate-x-1/2 -translate-y-1/2 cursor-ew-resize' },
                                { h: 'se', cls: 'bottom-0 right-0 translate-x-1/2 translate-y-1/2 cursor-nwse-resize' },
                                { h: 's',  cls: 'bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 cursor-ns-resize' },
                                { h: 'sw', cls: 'bottom-0 left-0 -translate-x-1/2 translate-y-1/2 cursor-nesw-resize' },
                                { h: 'w',  cls: 'top-1/2 left-0 -translate-x-1/2 -translate-y-1/2 cursor-ew-resize' },
                              ].map(pos => (
                                <div
                                  key={pos.h}
                                  onMouseDown={(e) => {
                                    e.stopPropagation();
                                    setResizeState({
                                      id: el.id,
                                      handle: pos.h,
                                      startX: e.clientX,
                                      startY: e.clientY,
                                      orig: { x: el.x, y: el.y, w: el.w, h: el.h },
                                      aspectRatio: el.w / el.h
                                    });
                                  }}
                                  className={`resize-handle ${pos.cls}`}
                                />
                              ))}

                              {/* Poignée de Rotation */}
                              <div className="absolute left-1/2 -translate-x-1/2 -top-8 flex flex-col items-center gap-1">
                                <div className="w-[1px] h-5 bg-[#3b82f6]"></div>
                                <div
                                  onMouseDown={(e) => {
                                    e.stopPropagation();
                                    const bbox = e.currentTarget.closest('[data-element]').getBoundingClientRect();
                                    setRotateState({
                                      id: el.id,
                                      center: { x: bbox.left + bbox.width / 2, y: bbox.top + bbox.height / 2 }
                                    });
                                  }}
                                  className="w-3 h-3 rounded-full bg-white border-2 border-[#3b82f6] cursor-grab active:cursor-grabbing shadow-sm"
                                  title="Faire pivoter"
                                />
                              </div>
                            </React.Fragment>
                          )}
                        </div>
                      );
                    })}

                    {/* Rectangle de sélection Lasso */}
                    {lassoState?.active && currentPageId === p.id && (
                      <div
                        className="absolute border border-dashed border-[#3b82f6] bg-[#3b82f6]/10 pointer-events-none z-50"
                        style={{
                          left: Math.min(lassoState.startX, lassoState.curX),
                          top: Math.min(lassoState.startY, lassoState.curY),
                          width: Math.abs(lassoState.curX - lassoState.startX),
                          height: Math.abs(lassoState.curY - lassoState.startY)
                        }}
                      />
                    )}
                  </div>
                ))}
              </div>
            </div>

            {/* CONTRÔLE DE ZOOM FLOTTANT (STYLE D'ORIGINE) */}
            <div className="no-print absolute bottom-6 left-1/2 -translate-x-1/2 z-30 flex items-center gap-2 px-3 py-2 rounded-full bg-[#0f0f10] text-white shadow-[0_8px_24px_rgba(0,0,0,0.2)] border border-[#27272a]">
              <div className="flex items-center gap-1">
                {[50, 75, 100, 150].map(val => (
                  <button
                    key={val}
                    onClick={() => setZoom(val)}
                    className={`h-7 px-2.5 rounded-full text-[11px] font-bold transition ${zoom === val ? 'bg-white text-black' : 'text-zinc-400 hover:text-white hover:bg-[#27272a]'}`}
                  >
                    {val}%
                  </button>
                ))}
                <button onClick={() => setZoom(85)} className="h-7 px-2.5 rounded-full text-[11px] font-medium text-zinc-400 hover:text-white">
                  Fit
                </button>
              </div>

              <div className="w-[1px] h-4 bg-[#27272a] mx-1"></div>
              <input
                type="range"
                min="25"
                max="200"
                value={zoom}
                onChange={(e) => setZoom(parseInt(e.target.value))}
                className="w-20 accent-white h-1 cursor-pointer"
              />
              <span className="text-[11px] font-bold w-9 text-right font-mono">{zoom}%</span>
            </div>

            {/* BARRE D'OUTILS CONTEXTUELLE FLOTTANTE (CANVA / FIGMA) AVEC BOUTON PRO */}
            {primarySelected && !primarySelected.locked && (
              <div className="no-print absolute top-16 left-1/2 -translate-x-1/2 z-40 bg-[#0f0f10] border border-[#27272a] rounded-xl shadow-[0_8px_32px_rgba(0,0,0,0.24)] p-2 flex items-center gap-2 text-white text-xs">
                {/* Typographie */}
                {['text', 'heading'].includes(primarySelected.type) && (
                  <React.Fragment>
                    <select
                      value={primarySelected.style.fontFamily || "Inter"}
                      onChange={(e) => updateElement(primarySelected.id, { style: { fontFamily: e.target.value } })}
                      className="h-7 rounded-lg bg-[#18181b] border border-[#27272a] text-[11px] px-2 text-white"
                    >
                      <option value="Inter">Inter</option>
                      <option value="Playfair Display">Playfair</option>
                      <option value="Space Grotesk">Space Grotesk</option>
                      <option value="JetBrains Mono">JetBrains</option>
                      <option value="Merriweather">Merriweather</option>
                    </select>

                    <input
                      type="number"
                      value={primarySelected.style.fontSize || 14}
                      onChange={(e) => updateElement(primarySelected.id, { style: { fontSize: parseInt(e.target.value) || 12 } })}
                      className="w-14 h-7 rounded-lg bg-[#18181b] border border-[#27272a] text-[11px] px-2 text-white text-center"
                      min="8"
                      max="120"
                    />

                    <input
                      type="color"
                      value={primarySelected.style.color || "#0f0f10"}
                      onChange={(e) => updateElement(primarySelected.id, { style: { color: e.target.value } })}
                      className="w-7 h-7 rounded-lg overflow-hidden border border-[#27272a] bg-transparent p-0 cursor-pointer"
                    />

                    <button
                      onClick={() => updateElement(primarySelected.id, { style: { fontWeight: primarySelected.style.fontWeight === '700' ? '400' : '700' } })}
                      className={`w-7 h-7 rounded-lg font-bold ${primarySelected.style.fontWeight === '700' ? 'bg-white text-black' : 'bg-[#18181b] text-zinc-300'}`}
                    >
                      B
                    </button>
                  </React.Fragment>
                )}

                {/* Couleur de fond */}
                <div className="flex items-center gap-1.5">
                  <span className="text-[10px] text-zinc-400">Fond:</span>
                  <input
                    type="color"
                    value={primarySelected.style.backgroundColor !== 'transparent' ? primarySelected.style.backgroundColor : "#ffffff"}
                    onChange={(e) => updateElement(primarySelected.id, { style: { backgroundColor: e.target.value } })}
                    className="w-7 h-7 rounded-lg border border-[#27272a] bg-transparent cursor-pointer"
                  />
                </div>

                <div className="w-[1px] h-4 bg-[#27272a]"></div>

                {/* BOUTON FORMULATION PRO */}
                {['text', 'heading', 'experience'].includes(primarySelected.type) && (
                  <button
                    onClick={() => boostText(primarySelected)}
                    className="h-7 px-2.5 rounded-lg bg-amber-400 hover:bg-amber-300 text-black text-[11px] font-bold flex items-center gap-1"
                    title="Formule automatiquement ce texte de façon professionnelle"
                  >
                    <span>✨</span>
                    <span>Pro</span>
                  </button>
                )}

                {/* Plans & Actions */}
                <button
                  onClick={() => updateElement(primarySelected.id, { zIndex: primarySelected.zIndex + 1 })}
                  className="px-2 py-1 rounded bg-[#18181b] hover:bg-[#27272a] text-[11px]"
                >
                  Avancer
                </button>
                <button
                  onClick={() => updateElement(primarySelected.id, { zIndex: Math.max(1, primarySelected.zIndex - 1) })}
                  className="px-2 py-1 rounded bg-[#18181b] hover:bg-[#27272a] text-[11px]"
                >
                  Reculer
                </button>
                <button
                  onClick={duplicateSelected}
                  className="px-2 py-1 rounded bg-[#18181b] hover:bg-[#27272a] text-[11px]"
                >
                  Dupliquer
                </button>
                <button
                  onClick={deleteSelected}
                  className="px-2 py-1 rounded bg-red-900/40 text-red-300 hover:bg-red-800 text-[11px]"
                >
                  Supprimer
                </button>
              </div>
            )}
          </main>

          {/* MODALE D'IMPORT INTELLIGENT */}
          {isImportOpen && (
            <div className="no-print fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
              <div className="w-full max-w-[520px] bg-[#fcfbf9] rounded-2xl shadow-2xl border border-[#e7e5e4] overflow-hidden">
                <div className="p-5 border-b border-[#e7e5e4] flex items-center justify-between">
                  <span className="font-bold text-[14px]">Import intelligent (simulation)</span>
                  <button onClick={() => setIsImportOpen(false)} className="w-8 h-8 rounded-full bg-zinc-100 flex items-center justify-center">
                    ✕
                  </button>
                </div>
                <div className="p-5 space-y-4">
                  <div className="text-[12px] text-zinc-600">
                    Collez le texte brut de votre profil LinkedIn ou CV. L'algorithme structurera automatiquement vos informations.
                  </div>
                  <textarea
                    rows="6"
                    value={importText}
                    onChange={(e) => setImportText(e.target.value)}
                    placeholder="Alexandra Dubois&#10;Product Designer Senior&#10;Designer produit avec 8 ans d'expérience..."
                    className="w-full rounded-xl border border-[#e7e5e4] bg-white p-3 text-[13px] outline-none font-mono"
                  ></textarea>
                  <div className="flex gap-2 justify-end">
                    <button onClick={() => setIsImportOpen(false)} className="h-10 px-5 rounded-xl bg-zinc-100 text-[13px] font-medium">
                      Annuler
                    </button>
                    <button
                      onClick={() => {
                        const lines = importText.split('\n').filter(Boolean);
                        const custom = {
                          ...DEFAULT_PROFILE,
                          name: lines[0] || DEFAULT_PROFILE.name,
                          role: lines[1] || DEFAULT_PROFILE.role,
                          summary: lines.slice(2).join(' ') || DEFAULT_PROFILE.summary
                        };
                        const updated = pages.map(p => p.id === currentPageId ? { ...p, elements: TEMPLATES.modern.build(custom) } : p);
                        updatePages(updated);
                        setIsImportOpen(false);
                        setImportText("");
                        showToast("CV analysé & appliqué !");
                      }}
                      className="h-10 px-5 rounded-xl bg-[#0f0f10] text-white text-[13px] font-bold"
                    >
                      Parser & Appliquer
                    </button>
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* TOAST FLOTTANT DE NOTIFICATION */}
          {toastMsg && (
            <div className="no-print fixed bottom-6 left-[320px] z-[200] bg-[#0f0f10] text-white border border-[#27272a] px-4 py-2 rounded-full text-[12px] font-medium shadow-xl flex items-center gap-2">
              <span className="text-emerald-400">✓</span>
              <span>{toastMsg}</span>
            </div>
          )}
        </div>
      );
    }

    ReactDOM.render(<App />, document.getElementById('root'));
  </script>
</body>
</html>