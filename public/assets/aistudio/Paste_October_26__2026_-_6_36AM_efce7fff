                      {Array.from({ length: 60 }).map((_, i) => {
                        const cm = i * 10;
                        const pos = cm * 3.78 * (zoom / 100);
                        return (
                          <div key={i} className="absolute left-0 right-0 border-t border-zinc-300" style={{ top: pos + panState.y }}>
                            <span className="absolute left-[1px] top-[1px] text-[7px] text-zinc-400 font-mono rotate-90 origin-left">{cm}</span>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                </React.Fragment>
