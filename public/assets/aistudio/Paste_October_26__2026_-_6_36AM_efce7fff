              <div className="flex items-center gap-3 text-[11px]">
                <div className="flex items-center gap-1.5">
                  <span className="font-medium text-zinc-700">Canvas A4</span>
                  <span className="px-2 py-[2px] rounded-full bg-[#0f0f10] text-white text-[10px] font-mono">794×1123px</span>
                </div>
                <span className="text-zinc-300">|</span>
                
                {/* Score de complétion */}
                <div className="flex items-center gap-2 bg-white px-2.5 py-1 rounded-full border border-zinc-200 shadow-xs">
                  <span className="text-[10px] font-bold text-zinc-600">Qualité CV :</span>
                  <div className="w-16 h-1.5 rounded-full bg-zinc-200 overflow-hidden">
                    <div 
                      className="h-full transition-all duration-500 rounded-full" 
                      style={{ 
                        width: `${cvHealth.score}%`,
                        backgroundColor: cvHealth.score > 70 ? '#10b981' : cvHealth.score > 40 ? '#f59e0b' : '#ef4444'
                      }}
                    />
                  </div>
                  <span className="font-mono text-[10px] font-bold text-zinc-700">{cvHealth.score}%</span>
                </div>
              </div>

              <div className="flex items-center gap-2 text-[10px] text-zinc-500">
                <span className="px-1.5 py-[1px] rounded border bg-white shadow-xs font-medium">Trackpad Mac</span> Pincer pour zoomer • 2 doigts pour naviguer
              </div>
            </header>

            {/* Zone de Canevas avec scroll et règles X/Y */}
            <div
              ref={canvasRef}
              className="flex-1 relative overflow-auto"
              onMouseDown={(e) => {
                if (isSpacePressed || e.button === 1) {
                  e.preventDefault();
                  setPanState(prev => ({ ...prev, isPanning: true, startX: e.clientX - prev.x, startY: e.clientY - prev.y }));
                  return;
                }
                if (e.target === canvasRef.current) {
                  const rect = canvasRef.current.getBoundingClientRect();
                  const curX = (e.clientX - rect.left - panState.x) / (zoom / 100);
                  const curY = (e.clientY - rect.top - panState.y) / (zoom / 100);
                  setLassoState({ active: true, startX: curX, startY: curY, curX, curY });
                  if (!e.shiftKey) setSelectedIds([]);
                }
              }}
              style={{ cursor: isSpacePressed || panState.isPanning ? 'grab' : 'default' }}
            >
              {/* Règles Claires X & Y */}
              {showRulers && (
                <React.Fragment>
                  <div className="no-print sticky top-0 left-0 z-20 h-[20px] bg-[#fcfbf9] border-b border-[#e7e5e4] flex" style={{ marginLeft: "20px" }}>
                    <div className="relative h-full flex-1 overflow-hidden pointer-events-none">
                      {Array.from({ length: 40 }).map((_, i) => {
                        const cm = i * 10;
                        const pos = cm * 3.78 * (zoom / 100);
                        return (
                          <div key={i} className="absolute top-0 bottom-0 border-l border-zinc-300" style={{ left: pos + panState.x }}>
                            <span className="absolute top-[2px] left-[2px] text-[8px] text-zinc-400 font-mono">{cm}</span>
                          </div>
                        );
                      })}
                    </div>
                  </div>

                  <div className="no-print sticky left-0 top-0 z-20 w-[20px] bg-[#fcfbf9] border-r border-[#e7e5e4] absolute" style={{ height: "100%" }}>
